# Copier en `.env` (ignore par git) et remplir. En CI, ce sont des secrets GitHub.

# URL publique du site GitHub Pages, sans slash final
SITE_URL=https://<utilisateur>.github.io/<repo>

# Webhook du channel general
DISCORD_WEBHOOK_GENERAL=https://discord.com/api/webhooks/.../...

# Un webhook par channel de comp, nomme comme dans comp_channels.json
DISCORD_WEBHOOK_BLACKTHORN=
DISCORD_WEBHOOK_JUGGERNAUT=
DISCORD_WEBHOOK_PRIMAL=
